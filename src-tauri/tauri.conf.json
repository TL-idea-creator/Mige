{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "密阁",
  "version": "1.0.0",
  "identifier": "org.liqihai.app.mige.win",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "密阁",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [],
    "shortDescription": "本地加密密码与验证码管理器",
    "longDescription": "密阁：本地加密保存账号密码与两步验证码，支持密码生成、导入导出，与鸿蒙版数据格式互通。"
  }
}
